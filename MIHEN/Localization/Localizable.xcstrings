    "week.edit.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görevin adına dokunarak onu taşıyabilir veya bu kez atlayabilirsin. Görev düzenleme sonraki tekrarları etkiler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a task to move or skip this occurrence. Editing a task affects later occurrences."
