    "help.body": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan'dan yaşam alanını seçerek hedef oluşturun. Günlük görevi bir hedefe bağlayın ve Bugün ekranından ilerleme kaydedin. Düzenli yedek alın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a life area in Plan to create a goal. Link a daily task to a goal, then record progress in Today. Back up regularly."
          }
        }
      }
    },
