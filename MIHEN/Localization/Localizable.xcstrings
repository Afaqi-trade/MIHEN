      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan miktar / bugünden bitişe kadar kalan takvim günü; yukarı yuvarlanır. Görevler kendiliğinden değiştirilmez. Yalnızca aynı ölçü birimine sahip bağlı görevler hedefe eklenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining amount / calendar days remaining, rounded up. Tasks are never changed automatically. Linked tasks contribute only when their unit matches the goal."
