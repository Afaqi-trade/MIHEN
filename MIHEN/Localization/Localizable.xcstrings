    "source.restore": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayırınca bağlantıdan önceki manuel miktar geri gelir. Kaynak kayıt silinmez. Bağlı kaydı düzenlemek miktarı günceller; silmek bağlantıyı kaldırır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting restores the previous manual amount without deleting the source. Editing the source updates the amount; deleting it disconnects the record."
          }
        }
      }
    },
    "source.disconnect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı ayır"
