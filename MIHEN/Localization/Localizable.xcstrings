    "nutrition.plan.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan bir niyettir; gerçekleşme üretmez. kcal ve ml ayrı karşılaştırılır. Egzersizde yakılan enerji toplam günlük harcama değildir; fark kalori açığı olarak yorumlanmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plan is an intention and creates no actual entry. kcal and ml are compared separately. Exercise energy is not total daily expenditure; the difference is not a calorie deficit."
          }
        }
      }
    },
