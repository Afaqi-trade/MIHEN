    "hijri.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ümmü'l-Kurâ takvim hesabı kullanılır; yerel/resmî dini takvimle farklılık olabilir. ±2 gün düzeltme yalnızca Hicri gösterim ve tekrar hesaplarını etkiler; geçmiş kayıtları taşımaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the Umm al-Qura calendar calculation. Local or official dates can differ. The ±2 day adjustment affects Hijri display and recurrence only; it never moves historical entries."
          }
        }
      }
    },
