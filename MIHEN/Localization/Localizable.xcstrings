    "backup.none": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz cihaz dışına yedek aktarılmadı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No backup has been exported yet."
          }
        }
      }
    },
    "backup.scope": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON yedeği kayıtları, uygulama tercihlerini ve kaydedilmiş namaz ayarlarını içerir. Cihaz dışına güvenli bir konuma aktarın. Ekran Süresi izni ve uygulama seçimi yeni cihazda yeniden kurulur; paylaşım dosyası hassas veriler içerir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON backups include records, app preferences and saved prayer settings. Export to a safe location outside this device. Screen Time authorization and app selection must be set up again on a new device; the shared file contains sensitive data."
          }
        }
      }
    },
    "backup.exported": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya dışa aktarıldı. Seçtiğiniz konumda saklandığını kontrol edin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File exported. Check it is kept in your chosen location."
          }
        }
      }
    },
    "backup.prayerIncluded": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek namaz ayarlarını da geri yükler; ayar yoksa varsayılana döner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup also restores prayer settings, or resets to defaults when absent."
          }
        }
      }
    },
    "backup.legacy": {
      "localizations": {
        "tr": {
          "stringUnit": {
