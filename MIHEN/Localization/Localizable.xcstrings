    },
    "qada": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaza namazı takibi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed prayer tracking"
          }
        }
      }
    },
    "qada.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan sayılar kendi eklediğiniz kayıtlardan hesaplanır. Vakit başına başlangıç miktarını kendiniz belirleyin. Vitir isteğe bağlı ayrı takip edilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining counts are based on your entries. Enter your own initial amount per prayer. Witr is tracked separately if desired."
          }
        }
      }
    },
    "activity.qadaDebt": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takip edilecek miktar ekle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add amount to track"
          }
