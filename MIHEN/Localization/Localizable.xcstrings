    "nutrition.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerler elle kaydedilir. Egzersiz kalorisi toplam günlük enerji harcaması değildir; bu kayıtlar kalori açığı veya tıbbi öneri hesaplamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are entered manually. Exercise calories are not total daily energy expenditure; these records do not calculate a calorie deficit or medical advice."
          }
        }
      }
    },
    "activity.food": {
      "localizations": {
