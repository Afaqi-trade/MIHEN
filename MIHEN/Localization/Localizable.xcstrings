    "notifications.permission": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev, hedef ve değerlendirmeler için bu cihazda bildirim izni istenecek."
          }
        },
        "en": {
          "stringUnit": {
