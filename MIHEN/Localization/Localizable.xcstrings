    "capacity.insufficient": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu miktar seçili günlerdeki boş zamanına sığmıyor. Tarihi uzatabilir, uygun günleri artırabilir veya hedef miktarını düzenleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This amount does not fit the free time on selected days. Extend the dates, add available days or edit the goal amount."
          }
        }
      }
    },
    "capacity.unknown": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili günlerde süresi belirsiz işler var. Önce haftalık planda bu işlerin tahmini süresini belirle veya farklı günler seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some selected days contain tasks without estimated duration. Set their estimates in the weekly plan or choose different days."
          }
        }
      }
    },
    "capacity.invalid": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini süre 0'dan büyük ve en çok 1440 dakika olmalı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated duration must be greater than zero and at most 1440 minutes."
          }
        }
      }
    },
    "capacity.required": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce haftalık hedef süreni ve birim başına süreyi belirle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set weekly time capacity and time per unit first."
          }
        }
      }
    },
    "capacity.estimate.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre, miktardan ayrıdır. Tahmini dakika bugünün açık planı ve sonraki tekrarlar içindir; geçmişe çalışma süresi eklemez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time is separate from quantity. Estimated minutes apply to today's open plan and future repeats; they do not add working time to history."
          }
        }
      }
    },
    "capacity.estimate": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adımın tahmini süresi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated time for this task"
          }
        }
      }
    },
    "capacity.minutes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre (dakika)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration (minutes)"
          }
        }
      }
    },
    "capacity.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün planlı işlerin için ayırabileceğin dakikayı gir. 0, o gün yeni iş için zaman ayırmadığın anlamına gelir. Bu hedeflenen süredir; gerçekleşen çalışma süresi değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter minutes available for planned tasks each day. Zero means no time for new tasks that day. This is planning capacity, not actual working time."
          }
        }
      }
    },
    "capacity.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayırabileceğim süre"
