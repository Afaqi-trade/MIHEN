            "state": "translated",
            "value": "Geri al"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        }
      }
    },
    "planning.availableDays": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygun günleri seç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose available days"
          }
        }
      }
    },
    "planning.actions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "planlanan adım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "planned actions"
          }
        }
      }
    },
    "planning.archive": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek planını arşivle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive future plan"
          }
        }
      }
    },
    "planning.archive.confirm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünden itibaren bu hedefin açık görevleri kapatılıp şablonları arşivlenecek. Kaydedilmiş miktarlar ve geçmiş korunur. Ardından yeni planı ayrıca onaylayabilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open tasks from today onward will close and their templates will be archived. Recorded quantities and history are preserved. You can then approve a new plan separately."
          }
        }
      }
    },
    "plan.tools": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlama araçların"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your planning tools"
          }
        }
      }
    },
    "focus.areas": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklandığın yaşam alanları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your focus areas"
          }
        }
      }
    },
    "other.areas": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer yaşam alanları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other life areas"
          }
        }
      }
    },
    "goals.none": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hedef yok · Hedef ekle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goals yet · Add a goal"
          }
        }
      }
    },
    "goals.count": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hedef"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "goals"
          }
        }
      }
    },
    "task.quick.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlığı yazıp bugün için kaydedebilirsin. Miktar, tekrar ve hedef bağlantısı ayrıntılarda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a title to save an action for today. Quantity, repetition and goal links are in details."
          }
        }
      }
    },
    "task.details": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miktar, tekrar ve diğer ayrıntılar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantity, repetition and other details"
          }
        }
      }
    },
    "starter.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçtiğin günlük adımlar eklenir. Tamamlanmış geçmiş oluşturulmaz. Her adımı sonradan düzenleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected daily actions are added. No completed history is created. You can edit each action later."
          }
        }
      }
    },
    "starter.selected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "günlük adım eklenecek"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "daily actions will be added"
          }
        }
      }
    },
    "starter.apply": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğim adımları ekle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add selected actions"
          }
        }
      }
    },
    "welcome.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MİHEN'e hoş geldin"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to MIHEN"
          }
        }
      }
    },
    "welcome.promise": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önem verdiğin hayatı, bugünün küçük adımlarına dönüştür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn what matters into small steps today."
          }
        }
      }
    },
    "welcome.steps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hedef seç. Haftana yer aç. Bugün küçük bir adım at."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a goal. Make room in your week. Take a small step today."
          }
        }
      }
    },
    "welcome.privacy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap gerekmez. Temel kullanım çevrimdışı çalışır; kayıtların cihazında kalır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account needed. Core features work offline; your records stay on your device."
          }
        }
      }
    },
    "welcome.focus": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dönemde neye yer açmak istersin?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to make room for?"
          }
        }
      }
    },
    "welcome.focus.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1-3 alanla başlayabilirsin. Sekiz yaşam alanı korunur; tercihlerini sonra değiştirebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start with 1-3 areas. All eight areas remain available; change your choices later."
          }
        }
      }
    },
    "welcome.begin": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü ilk adımıma geç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start my first step today"
          }
        }
      }
    },
    "today.first.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir adımla başla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one small step"
          }
        }
      }
    },
    "today.first.body": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün yapmak istediğin tek bir eylem ekle. Bütün hayatını bir kerede planlaman gerekmiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one action for today. You do not need to plan your whole life at once."
          }
        }
      }
    },
    "today.first.add": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk adımımı ekle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add my first step"
          }
        }
      }
    },
    "today.steps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü adımların"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your steps today"
          }
        }
      }
    },
    "today.finished": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tamamlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "finished"
          }
        }
      }
    },
    "today.started": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "işe başlandı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "in progress"
          }
        }
      }
    },
    "today.partial.encouragement": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısmi ilerlemen kaydedildi. Kaldığın yerden devam edebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your partial progress is recorded. Continue where you left off."
          }
        }
      }
    },
    "today.completed.encouragement": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attığın adımlar kaydedildi. Devam etmek ya da dinlenmek senin seçimin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your steps are recorded. Continuing or resting is your choice."
          }
        }
      }
    },
    "today.next.encouragement": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki küçük adımını seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your next small step."
          }
        }
      }
    },
    "today.reviewsDue": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar zamanı gelen kayıtlar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviews due"
          }
        }
      }
    },
    "focus.choose": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün odağını seç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose today's focus"
          }
        }
      }
    },
    "focus.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün için en çok üç açık eylem seç. Bu seçim yalnızca bugünün önceliğini değiştirir; geçmişi ve gelecek tekrarları değiştirmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to three open actions for today. This changes today's priorities only, preserving history and future repetitions."
          }
        }
      }
    },
    "routine.empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah veya akşam için küçük bir rutin oluştur. Yeni adımlar ekleyebilir veya mevcut görevlerini seçebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a small morning or evening routine. Add new steps or choose existing tasks."
          }
        }
      }
    },
    "routine.morning": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah rutini"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning routine"
          }
        }
      }
    },
    "routine.evening": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam rutini"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening routine"
          }
        }
      }
    },
    "routine.steps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutinin adımları"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine steps"
          }
        }
      }
    },
    "routine.existing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut görevlerden seç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose existing tasks"
          }
        }
      }
    },
    "routine.step.add": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni adım oluştur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new step"
          }
        }
      }
    },
    "routine.schedule.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle ile adımların sırasını değiştir. Yeni adım günlük alışkanlık olarak başlar; ayrıntılarında günleri değiştirebilirsin. Mevcut görevlerin tekrar planı korunur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Edit to reorder steps. New steps start as daily habits; change days in their details. Existing task schedules are preserved."
          }
        }
      }
    },
    "routine.reminder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutine özel saatli hatırlatma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder at a chosen time"
          }
        }
      }
    },
    "routine.pause": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek tekrarları duraklat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause future repetitions"
          }
        }
      }
    },
    "routine.resume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelecek tekrarları sürdür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume future repetitions"
          }
        }
      }
    },
    "routine.paused": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutindeki görev şablonları duraklatıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task templates in this routine are paused."
          }
        }
      }
    },
    "routine.pause.confirm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruptaki tüm görev şablonlarının gelecek tekrarları duraklatılacak veya sürdürülecek. Ortak görevler diğer rutinlerde de etkilenir. Bugünkü ve geçmiş kayıtlar değişmez; sürdürme yarından başlar. Tek seferlik adımların tarihini ayrıca düzenleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future repetitions of all task templates in this group will pause or resume. Shared tasks are affected in other routines too. Today's and past entries stay unchanged; resuming starts tomorrow. Edit one-time steps' dates separately."
          }
        }
      }
    },
    "reminder.time": {
      "localizations": {
