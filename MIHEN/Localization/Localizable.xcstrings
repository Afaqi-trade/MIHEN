    "khatm.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık şablon: üç Kur'an hatmi; bunlardan biri meal ile. Ayrıca bir tefsir okuma planı. Mealli hatim dördüncü Kur'an hatmi olarak sayılmaz. Toplam sayfa sayısını kendi baskınıza göre düzenleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Annual template: three Quran readings, one with translation, plus one commentary plan. The translation reading is included in the three. Set page totals for your own edition."
          }
        }
      }
    },
