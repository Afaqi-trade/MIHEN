    "spiritual.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modül kişisel faaliyet takibidir. Şablonlar zorunluluk veya dini hüküm değildir; düzenleyebilir, arşivleyebilir ya da hiç eklemeyebilirsiniz. Meal, tefsir ve ses içerikleri dağıtılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This module tracks personal activities. Templates are optional and do not constitute religious rulings. Edit, archive or omit them. No translations, commentary or recordings are distributed."
          }
        }
      }
    },
