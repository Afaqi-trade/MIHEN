    "notifications.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yakın 60 hatırlatma, önümüzdeki 7 günlük görevler arasından planlanır. Akşam ve haftalık değerlendirme saati 20:00'dır. Sessiz saatlerdeki bildirimler atlanır. Yeni günler için uygulamayı düzenli açın; iOS teslimatı etkileyebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules the next 60 reminders, including tasks in the next 7 days. Evening and weekly reviews use 20:00. Reminders in quiet hours are omitted. Open the app regularly to refresh; iOS may affect delivery."
          }
        }
      }
    },
