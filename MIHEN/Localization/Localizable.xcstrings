{
  "sourceLanguage": "tr",
  "strings": {
    "planning.unit.locked": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş katkıların anlamını korumak için bu hedefin birimi değiştirilemez. Farklı birim için yeni hedef oluştur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This goal's unit is locked to preserve the meaning of recorded contributions. Create a new goal for a different unit."
          }
        }
      }
    },
    "planning.roadmap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıldan haftaya yol haritası"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roadmap from year to week"
          }
        }
      }
    },
    "planning.months": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık dağılım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly breakdown"
          }
        }
      }
    },
    "planning.weeks": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık dağılım"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly breakdown"
          }
        }
      }
    },
    "planning.saveMilestones": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık ara sonuçları da kaydet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also save monthly milestones"
          }
        }
      }
    },
    "planning.milestones.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara sonuçlar ayrıca ilerleme üretmez. Hedef katkısı yalnızca gerçek görev ve bağımsız katkı kayıtlarından hesaplanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Milestones do not generate extra progress. Goal contribution comes only from actual tasks and independent contribution entries."
          }
        }
      }
    },
    "connections": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantılar ve hatırlatmalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connections and reminders"
          }
        }
      }
    },
    "timezone.common": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kullanılan bölgeler"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common time zones"
          }
        }
      }
    },
    "timezone.search": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehir veya bölge ara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search city or region"
          }
        }
      }
    },
    "reading.quantity.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıtta okuduğun sayfa miktarını gir; ulaştığın sayfa numarasını değil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the number of pages read in this entry, not the page number you reached."
          }
        }
      }
    },
    "fasting.upcoming": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlı kayıtlar"
          }
        },
        "en": {
