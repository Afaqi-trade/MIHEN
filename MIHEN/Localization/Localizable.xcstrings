            "state": "translated",
            "value": "Configure quick water amounts"
          }
        }
      }
    },
    "nutrition.health.readOnly": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık kaydı bu ekrandan değiştirilemez; Sağlık bağlantısından yeniden alabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Health record cannot be edited here; import it again through the Health connection."
          }
        }
      }
    },
    "routine.step.missing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adım artık bulunamıyor. Eski oturum sırası değiştirilmedi; sonraki adıma geçebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step is no longer available. The saved session order is unchanged; you can move to the next step."
          }
        }
      }
    },
    "routine.unavailable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rutin bugün için uygun adım içermiyor veya duraklatılmış. Arşivli adımların tekrarını görev düzenleyicisinden ayrıca değiştirebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This routine has no eligible steps today or is paused. Archived task repeats can be changed separately in the task editor."
          }
        }
      }
    },
    "routine.end": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıranın sonuna geldin. Gerçekleşmeler görev kartlarındaki kayıtlarına göre korunur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached the end. Progress remains as recorded on the task cards."
          }
        }
      }
    },
    "routine.next": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki adıma geç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to next step"
          }
        }
      }
    },
    "routine.run.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü adımları sırayla gözden geçir. İlerleme aynı görev kaydına yazılır; bu sıra ikinci bir başarı üretmez. Sonrakine geçmek görevi tamamlamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review today's steps in order. Progress uses the same task record; the session adds no second achievement. Moving to the next step does not complete a task."
          }
        }
      }
    },
    "routine.group.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutin takvimi grup görünümünü ve hatırlatmasını yönetir. Mevcut görevlerin tekrarları korunur; ortak bir görevi duraklatmaz. Yeni adımlar seçili günlerle başlar. Adımı kaydetmek görev listesine de ekler; gruptan çıkmak görevi silmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine schedule controls the group and its reminder. Existing tasks keep their repeats; shared tasks are not paused. New steps start on selected days. Saving a step also adds it to the task list; leaving the group does not delete it."
          }
        }
      }
    },
    "routine.days": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutinin günleri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine days"
          }
        }
      }
    },
    "routine.start": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutini başlat / sürdür"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start / resume routine"
          }
        }
      }
    },
    "planning.support.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dakika veya sayfa alışkanlığı kitap hedefini otomatik tamamlamaz. Bağlantı, destek ilişkisini gösterir; farklı birimler toplanmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minute or page habit does not automatically complete a book goal. The connection shows support; different units are not summed."
          }
        }
      }
    },
    "planning.support": {
      "localizations": {
        "tr": {
