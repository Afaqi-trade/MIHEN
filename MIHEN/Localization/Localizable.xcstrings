    "nutrition.shortcuts.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10–2000 ml arasında en çok dört farklı miktarı virgülle ayırarak yaz. Örnek: 200,350,500. Bunlar yalnızca senin hızlı kayıt düğmelerindir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter up to four different amounts from 10 to 2000 ml, separated by commas. Example: 200,350,500. These are only your quick-entry buttons."
          }
        }
      }
    },
    "nutrition.shortcuts": {
      "localizations": {
        "tr": {
          "stringUnit": {
