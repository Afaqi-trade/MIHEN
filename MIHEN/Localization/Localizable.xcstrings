{
  "sourceLanguage": "tr",
  "strings": {
    "report.goals.current": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönemle ilişkili hedefler (güncel durum)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals associated with this period (current status)"
          }
        }
      }
    },
    "calendar.apple.export": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Takvim'de kopyasını oluştur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a copy in Apple Calendar"
          }
        }
      }
    },
    "calendar.apple.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu etkinliğin tek bir kopyası Apple düzenleyicisinde açılır. Kaydetme kararını orada verirsiniz. Tekrar kuralları aktarılmaz; iki kopya otomatik eşitlenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single copy opens in Apple's editor for you to save. Recurrence rules are not transferred; the copies do not synchronize automatically."
          }
        }
      }
    },
    "custom.reminders": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel hatırlatmalar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal reminders"
          }
        }
      }
    },
    "custom.reminders.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz saatlere hatırlatma ekleyin. Profilde bildirimleri etkinleştirin. Sessiz saatler ve sistem izinleri geçerlidir; yakın 7 gün için en fazla 60 bildirim planlanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add reminders at your preferred times. Enable notifications in Profile. Quiet hours and system permissions apply; up to 60 notifications are scheduled for the next 7 days."
          }
        }
      }
    },
    "reminder.water": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su içmeyi hatırla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember to drink water"
          }
        }
      }
    },
    "reminder.movement": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket molası"
          }
        },
