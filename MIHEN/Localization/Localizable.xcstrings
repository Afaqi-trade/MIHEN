    "backup.location.notice": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeğin nerede saklandığını uygulama göremez. Dosyalar'da seçtiğiniz konumu kontrol edin; dışa aktarmak otomatik yedekleme değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app cannot see where your backup is stored. Check the location you chose in Files; exporting is not automatic backup."
