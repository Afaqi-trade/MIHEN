    "report.compare.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki aralık aynı sayıda takvim günüdür. Kayıt olmayan ölçüm sıfır sayılmaz. Farklar yalnızca iki dönemde de en az üç kayıtlı gün ve aynı birim varsa gösterilir; bu bir anlamlılık veya yaşam kalitesi değerlendirmesi değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous range has the same number of calendar days. Missing metrics are not zero. Differences appear only with at least three recorded days in both periods and matching units; this is not a significance or quality-of-life assessment."
          }
        }
      }
    },
    "report.compare": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki dönemle karşılaştırma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with the previous period"
          }
        }
      }
    },
    "report.cutoff.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçinde bulunduğumuz dönem bugünün sonuna kadar hesaplanır; gelecek günler geçmiş sonuç gibi gösterilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current period is calculated through today; future days are not shown as historical results."
