    "data.delete.confirm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hedefler, geçmiş ve tercihler kalıcı olarak silinsin mi? Bu işlem geri alınamaz."
          }
