    "health.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili günün adım ve aktif enerji toplamlarını isteğe bağlı okuyabilirsin. Sağlık'a veri yazılmaz. Boş sonuç veri veya okuma izni olmadığını gösterebilir. Kaydet dediğinde MİHEN günlüğüne tek günlük özet eklenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionally read steps and active energy for the selected day. Nothing is written to Health. An empty result may mean no data or read permission. Saving adds one daily snapshot to your MIHEN log."
          }
        }
      }
    },
