    "source.disconnectFirst": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adım bir modül kaydına bağlı. Miktarı kaynakta değiştirin; tarih, birim, durum veya bağımsız miktar için önce bağlantıyı ayırın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is connected to a module record. Edit its amount at the source; disconnect before changing day, unit, status or independent progress."
          }
        }
      }
    },
    "source.incompatible": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt aynı gün, alan ve birimde olmalı; her kayıt yalnızca bir adıma bağlanabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day, area and unit must match. Each record can connect to only one task."
          }
        }
      }
    },
    "source.connect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı bağla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect record"
          }
        }
      }
    },
    "source.confirmation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydın miktarı mevcut manuel miktarın yerine geçsin mi? Kaynak daha sonra değişirse bu adım da güncellenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the manual amount with this record? Later source changes will update this task too."
          }
        }
      }
    },
    "source.empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün, alan ve birimde bağlanabilecek kayıt yok. Önce ilgili modülde kayıt oluşturabilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible record for this day, area and unit. Create a record in the relevant module first."
          }
        }
      }
    },
    "source.available": {
      "localizations": {
        "tr": {
