    "source.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı gün, yaşam alanı ve birimdeki bir modül kaydını bu adıma bağlayabilirsin. Bağlı miktar mevcut elle girilen miktarın yerine geçer; ikisi toplanmaz. Hedefi aşan kısım bu adıma eklenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a module record with the same day, area and unit. Its amount replaces the manual amount; they are not added together. Amount beyond the task target is not applied."
          }
        }
      }
    },
    "source.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bağlantısı"
          }
        },
