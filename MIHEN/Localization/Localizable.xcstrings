    },
    "notifications.denied": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni verilmedi. iOS Ayarlar bölümünden etkinleştirebilirsiniz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was not granted. Enable it in iOS Settings."
          }
        }
      }
    },
    "privacy.body": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MİHEN kişisel hedeflerinizi, görevlerinizi ve isteğe bağlı manevi, sağlık ve mali kayıtlarınızı cihazınızda tutar. Geliştiriciye veri aktarılmaz; hesap, reklam veya analitik kullanılmaz. Bildirimler cihazda planlanır. Face ID biyometrik verisi uygulamaya verilmez; doğrulamayı iOS yapar. Widget, App Group üzerinden günlük özeti okur; kilit etkinse içerik gizlenir. Paylaştığınız yedekler şifrelenmemiş kişisel veriler içerir. Sistem cihaz yedekleri iOS/iCloud ayarlarınıza bağlı olabilir; uygulama iCloud senkronizasyonu sunmaz. Profil'den tüm verileri silebilirsiniz. Yayın sahibinin iletişim bilgisi ve politika URL'si yayın öncesi tamamlanmalıdır. Hukuki uyumluluk değerlendirmesi henüz tamamlanmamıştır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MİHEN keeps your goals, tasks and optional spiritual, health and financial records on your device. No data is sent to the developer. No account, advertising or analytics is used. Notifications are scheduled locally. Biometric data is handled by iOS and is never provided to the app. The widget reads a daily summary through App Groups; content is hidden when lock is enabled. Exported backups contain unencrypted personal data. Device backups depend on your iOS/iCloud settings; the app does not provide iCloud sync. Delete all records in Profile. Publisher contact information and the policy URL must be completed before release. Legal compliance has not yet been assessed."
          }
        }
      }
    },
