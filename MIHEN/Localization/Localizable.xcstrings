    "notifications.systemDenied": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone bildirim izni kapalı. Hatırlatıcıların görünmesi için iPhone ayarlarından izni açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone notification permission is off. Enable it in iPhone settings to receive reminders."
          }
        }
      }
    },
