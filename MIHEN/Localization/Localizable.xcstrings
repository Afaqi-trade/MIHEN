        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modül kayıtları kendi birimleriyle ayrı gösterilir; görev katkılarıyla toplanmaz. Kayıtlı gün, o günün tümüyle kaydedildiği anlamına gelmez. Kaza bakiyeleri kayıt tarihine göredir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Module records keep their own units and are not added to task contributions. A recorded day does not imply a complete daily record. Qada balances follow entry dates."
