    "goal.split": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefi günlere böl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split goal into days"
          }
        }
      }
    },
    "goal.split.explanation": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan miktar seçilen günlere eşit dağıtılır (en çok 366 gün). Aynı birim korunur. Etkin bağlı görev varsa önce mevcut planı düzenleyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remaining quantity is distributed equally over selected days (up to 366 days). Units are preserved. Edit existing active linked tasks before creating another plan."
          }
        }
      }
    },
    "goal.split.apply": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük görevleri oluştur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create daily tasks"
          }
        }
      }
    },
    "goal.split.confirm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
