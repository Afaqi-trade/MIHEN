    "report.areas.recorded.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bulunan alan sayısı bir hedef veya başarı puanı değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of areas with records is not a target or a measure of success."
          }
        }
      }
    },
    "nutrition.summary.limit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz enerjisi günlük toplam harcama değildir; kayıt olmayan veri sıfır tüketim anlamına gelmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise energy is not total daily expenditure; missing records do not mean zero intake."
          }
        }
      }
    },
    "planning.firstWeek": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk 7 günlük öneri"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first 7 days"
          }
        }
      }
    },
    "planning.firstWeek.help": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç tarihinden sonraki ilk yedi gün gösterilir. Bu yalnızca öneridir; onay vermeden görev oluşturulmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first seven days from your start date are shown. This is only a proposal; no tasks are created until you confirm."
          }
        }
      }
    },
    "planning.firstWeek.empty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedi günde önerilen adım yok."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No steps are proposed in these seven days."
          }
        }
      }
    },
    "planning.firstWeek.total": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk yedi günün toplamı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total for the first seven days"
