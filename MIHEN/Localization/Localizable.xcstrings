    "planning.linked": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hedefte etkin görevler var. Görevleri düzenleyin veya gelecek planını arşivleyip yeniden planlayın. Geçmiş kayıtlar korunur."
          }
